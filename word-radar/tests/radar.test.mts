import test from 'node:test';
import assert from 'node:assert/strict';
import {newKeyword,type Source} from '../lib/radar/types.ts';
import {scoreKeyword,trendStats,keywordKey,parseCSV,exportKeywords,safeHttpUrl} from '../lib/radar/scoring.ts';
import {scanSource,verifyKeyword,publicUrl,number,compareTrends} from '../lib/radar/providers.ts';
import {buildBackup,parseBackup} from '../lib/radar/backup.ts';

function source(type:Source['type'],target='test'):Source{return {id:'test',type,target,name:'Test',market:'US',enabled:true};}
const nativeFetch=globalThis.fetch;
function mockFetch(body:unknown,status=200){globalThis.fetch=async()=>new Response(typeof body==='string'?body:JSON.stringify(body),{status});}

test('unknown metrics remain unknown and receive no made-up score',()=>{const k=newKeyword('sample');const s=scoreKeyword(k);assert.equal(s.score,null);assert.equal(s.coverage,0);assert.equal(s.recommendation,'待补证据');assert.equal(k.volume,null);});
test('complete evidence stays bounded and rights failure blocks',()=>{const k=newKeyword('sample');k.volume=50000;k.kd=10;k.trend=Array.from({length:9},(_,i)=>({date:String(i),value:i*10}));k.review={intent:true,gap:true,monetization:true,feasible:true,rights:true};let s=scoreKeyword(k);assert.equal(s.coverage,100);assert.ok(s.score!>=75&&s.score!<=100);assert.equal(s.recommendation,'优先验证');k.review.rights=false;s=scoreKeyword(k);assert.equal(s.recommendation,'暂停研究');});
test('historical cases are not recommended as current opportunities',()=>{const k=newKeyword('case');k.origin='case';assert.equal(scoreKeyword(k).recommendation,'需更新证据');});
test('trend handles sparse data and zero baseline safely',()=>{assert.equal(trendStats([]),null);assert.equal(trendStats([{date:'1',value:2}]),null);const s=trendStats([0,0,0,2,8,12].map((value,i)=>({date:String(i),value})));assert.equal(s?.growth,null);assert.equal(s?.rising,true);});
test('market-aware dedupe normalizes case and whitespace',()=>{assert.equal(keywordKey('  Invoice   Generator ','us'),keywordKey('invoice generator','US'));assert.notEqual(keywordKey('invoice','US'),keywordKey('invoice','GB'));});
test('CSV supports quoted commas, escaped quotes, multiline, BOM and semicolon',()=>{assert.deepEqual(parseCSV('\uFEFFkeyword,notes\r\n"a,b","line 1\nline ""2"""'),[['keyword','notes'],['a,b','line 1\nline "2"']]);assert.deepEqual(parseCSV('keyword;volume\na;1200'),[['keyword','volume'],['a','1200']]);assert.deepEqual(parseCSV('keyword\tvolume\na\t1200'),[['keyword','volume'],['a','1200']]);assert.throws(()=>parseCSV('keyword\n"unclosed'));});
test('CSV export protects spreadsheet formulas',()=>{const k=newKeyword('=HYPERLINK("https://example.com")');k.notes='+SUM(1,2)';const data=parseCSV(exportKeywords([k]));assert.equal(data[1][0][0],"'");assert.equal(data[1][10][0],"'");});
test('safe external links reject executable schemes',()=>{assert.equal(safeHttpUrl('javascript:alert(1)'),'');assert.equal(safeHttpUrl('data:text/html,foo'),'');assert.equal(safeHttpUrl('https://example.com'),'https://example.com/');});
test('sitemap fetch rejects local, IP, non-HTTPS and credential URLs',()=>{for(const u of ['http://example.com','https://localhost/a','https://127.0.0.1/a','https://[::1]/a','https://user:pass@example.com','https://server.internal/a','https://example.com:8080/a'])assert.throws(()=>publicUrl(u));assert.equal(publicUrl('https://example.com/sitemap.xml').hostname,'example.com');});
test('numeric imports preserve missing versus zero and support K/M',()=>{assert.equal(number(''),null);assert.equal(number('n/a'),null);assert.equal(number('-1'),null);assert.equal(number('0'),0);assert.equal(number('1.2K'),1200);assert.equal(number('2M'),2000000);assert.equal(number('$1,200.50'),1200.5);});
test('sitemap baseline emits nothing; later scans emit only additions',async()=>{try{const s=source('sitemap','https://example.com/sitemap.xml');mockFetch('<urlset><url><loc>https://example.com/old-tool</loc></url></urlset>');const first=await scanSource(s,{},null);assert.equal(first.keywords.length,0);assert.equal(first.snapshot?.length,1);mockFetch('<urlset><url><loc>https://example.com/old-tool</loc></url><url><loc>https://example.com/new-generator</loc></url></urlset>');const next=await scanSource(s,{},first.snapshot!);assert.equal(next.keywords.length,1);assert.equal(next.keywords[0].keyword,'new generator');assert.equal(next.keywords[0].volume,null);assert.equal(next.keywords[0].evidence[0].kind,'observed');}finally{globalThis.fetch=nativeFetch;}});
test('sitemap refuses cross-origin indexes and invalid XML',async()=>{try{mockFetch('<sitemapindex><sitemap><loc>https://other.example.com/a.xml</loc></sitemap></sitemapindex>');await assert.rejects(scanSource(source('sitemap','https://example.com/s.xml'),{},null),/跨域/);mockFetch('<html>not a sitemap</html>');await assert.rejects(scanSource(source('sitemap','https://example.com/s.xml'),{},null),/XML/);}finally{globalThis.fetch=nativeFetch;}});
test('large sitemap delta is batched without swallowing unprocessed pages',async()=>{try{mockFetch('<urlset>'+Array.from({length:102},(_,i)=>`<url><loc>https://example.com/tool-${i}</loc></url>`).join('')+'</urlset>');const s=source('sitemap','https://example.com/s.xml');const first=await scanSource(s,{},[]);assert.equal(first.keywords.length,100);assert.equal(first.partial,true);const next=await scanSource(s,{},first.snapshot!);assert.equal(next.keywords.length,2);}finally{globalThis.fetch=nativeFetch;}});
test('Hacker News ingestion does not turn upvotes into volume',async()=>{try{mockFetch({hits:[{title:'Show HN: New PDF tool',objectID:'123',created_at:'2026-11-01T00:00:00Z',points:200}]});const r=await scanSource(source('hackernews'),{},null);assert.equal(r.keywords[0].keyword,'New PDF tool');assert.equal(r.keywords[0].volume,null);assert.match(r.keywords[0].risks[0],/待提炼/);}finally{globalThis.fetch=nativeFetch;}});
test('Hugging Face downloads do not become search volume',async()=>{try{mockFetch([{id:'org/model-v1',downloads:80000,pipeline_tag:'text-to-image'}]);const r=await scanSource(source('huggingface'),{},null);assert.equal(r.keywords[0].keyword,'model-v1');assert.equal(r.keywords[0].volume,null);assert.equal(r.keywords[0].category,'ai');}finally{globalThis.fetch=nativeFetch;}});
test('paid adapters fail clearly without credentials, no calls',async()=>{for(const t of ['trends','x','semrush'] as const)await assert.rejects(scanSource(source(t),{},null),/密钥|Token/);});
test('rate limit error does not leak credential URL',async()=>{try{mockFetch('error',429);await assert.rejects(scanSource(source('semrush','example.com'),{semrush:'do-not-leak'},null),e=>e instanceof Error&&/429/.test(e.message)&&!e.message.includes('do-not-leak'));}finally{globalThis.fetch=nativeFetch;}});
test('Cloudflare-compatible manual redirects are rejected without following',async()=>{try{globalThis.fetch=async(_url,options)=>{assert.equal(options?.redirect,'manual');return new Response('',{status:302,headers:{location:'http://127.0.0.1/'}});};await assert.rejects(scanSource(source('sitemap','https://example.com/a.xml'),{},null),/重定向/);}finally{globalThis.fetch=nativeFetch;}});
test('verification maps all windows, filters partial points and preserves human decision',async()=>{try{let calls=0;globalThis.fetch=async(input)=>{calls++;const url=new URL(String(input));return new Response(JSON.stringify(url.searchParams.get('engine')==='google'?{organic_results:[{position:1,title:'Tool',link:'https://example.com',snippet:'Test'}]}:{interest_over_time:{timeline_data:[{date:'day 1',values:[{extracted_value:2},{extracted_value:10}]},{date:'day 2',values:[{extracted_value:5},{extracted_value:9}]},{date:'partial',partial:true,values:[{extracted_value:100}]}]}}));};const k=newKeyword('tool');k.origin='case';k.status='watching';const r=await verifyKeyword(k,'test');assert.equal(calls,4);assert.equal(r.errors.length,0);assert.equal(r.keyword.trend.length,2);assert.equal(r.keyword.trend90.length,2);assert.equal(r.keyword.trend5y.length,2);assert.equal(r.keyword.serp.length,1);assert.equal(r.keyword.origin,'case');assert.equal(r.keyword.status,'watching');assert.ok(r.keyword.verificationDate);}finally{globalThis.fetch=nativeFetch;}});
test('verification missing data is not fabricated as zero',async()=>{try{mockFetch({interest_over_time:{timeline_data:[{date:'1',values:[]},{date:'2',values:[]}]}});const r=await verifyKeyword(newKeyword('tool'),'test');assert.equal(r.errors.length,4);assert.equal(r.keyword.trend.length,0);assert.equal(r.keyword.verificationDate,undefined);}finally{globalThis.fetch=nativeFetch;}});
test('backup roundtrip preserves research and sanitizes unsafe evidence links',()=>{const k=newKeyword('invoice generator');k.status='watching';k.notes='研究结论：需求真实';k.volume=12000;const bad={label:'危险',url:'javascript:alert(1)',excerpt:'x',date:k.firstSeen,kind:'manual' as const};const good={label:'来源',url:'https://example.com/a',excerpt:'x',date:k.firstSeen,kind:'manual' as const};k.evidence=[good,bad];k.serp=[{position:1,title:'T',url:'https://example.com/s',snippet:''},{position:2,title:'X',url:'data:text/html,evil',snippet:''}];const parsed=parseBackup(buildBackup([k],[],[]));assert.equal(parsed.keywords.length,1);assert.equal(parsed.keywords[0].status,'watching');assert.equal(parsed.keywords[0].notes,'研究结论：需求真实');assert.equal(parsed.keywords[0].volume,12000);assert.equal(parsed.keywords[0].evidence.length,1);assert.equal(parsed.keywords[0].evidence[0].url,'https://example.com/a');assert.equal(parsed.keywords[0].serp.length,1);});
test('restore rejects foreign or malformed backup files',()=>{assert.throws(()=>parseBackup({app:'other',version:1,keywords:[],sources:[]}));assert.throws(()=>parseBackup({app:'word-radar',version:1,keywords:[{id:'x'}],sources:[]}));assert.throws(()=>parseBackup({app:'word-radar',version:1,keywords:[],sources:[{id:'s',type:'trends'}]}));});
test('trend comparison maps one query timeline into per-keyword series',async()=>{try{let calls=0,queried='';globalThis.fetch=async(input)=>{calls++;const u=new URL(String(input));queried=u.searchParams.get('q')||'';return new Response(JSON.stringify({interest_over_time:{timeline_data:[{date:'d1',values:[{extracted_value:3},{extracted_value:8}]},{date:'d2',values:[{extracted_value:6},{extracted_value:4}]},{date:'d3',partial:true,values:[{extracted_value:99},{extracted_value:99}]}]}}));};const series=await compareTrends(['alpha','beta'],'US','now 7-d','test');assert.equal(calls,1);assert.equal(queried,'alpha,beta');assert.deepEqual(series[0].points.map(p=>p.value),[3,6]);assert.deepEqual(series[1].points.map(p=>p.value),[8,4]);assert.equal(series[0].points[0].date,'d1');}finally{globalThis.fetch=nativeFetch;}});
test('trend comparison refuses wrong word counts and empty timelines',async()=>{await assert.rejects(compareTrends(['only'],'US','now 7-d','k'),/2–5/);try{mockFetch({interest_over_time:{timeline_data:[{date:'d1',values:[{extracted_value:3},{extracted_value:8}]}]}});await assert.rejects(compareTrends(['alpha','beta'],'US','now 7-d','k'),/没有足够数据/);}finally{globalThis.fetch=nativeFetch;}});
